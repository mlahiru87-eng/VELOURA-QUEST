{
  "entities": {
    "users": {
      "title": "users",
      "description": "User profiles and account data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "referralCode": { "type": "string" },
        "referredBy": { "type": "string" },
        "currentBalance": { "type": "number" },
        "totalEarned": { "type": "number" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "tasks": {
      "title": "tasks",
      "description": "Available daily external video and quest tasks",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "reward": { "type": "number" },
        "thumbnailUrl": { "type": "string" },
        "videoUrl": { "type": "string" },
        "duration": { "type": "number" },
        "category": { "type": "string" },
        "createdAt": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["title", "description", "reward", "thumbnailUrl", "videoUrl", "duration", "category", "createdAt"]
    },
    "taskSessions": {
      "title": "taskSessions",
      "description": "Pending and completed task execution session records",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "taskId": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string" },
        "startedAt": { "type": "string" }
      },
      "required": ["sessionId", "taskId", "userId", "status"]
    },
    "taskCompletions": {
      "title": "taskCompletions",
      "description": "User completed task records",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "taskId": { "type": "string" },
        "completedAt": { "type": "string" },
        "claimedAmount": { "type": "number" }
      },
      "required": ["userId", "taskId"]
    },
    "transactions": {
      "title": "transactions",
      "description": "User wallet transaction logs",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "type", "amount"]
    },
    "withdrawals": {
      "title": "withdrawals",
      "description": "Withdrawal request logs",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "amount": { "type": "number" },
        "method": { "type": "string" },
        "destination": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "amount", "method", "status"]
    },
    "referrals": {
      "title": "referrals",
      "description": "Referral connections and bonus tracking",
      "type": "object",
      "properties": {
        "referrerId": { "type": "string" },
        "refereeId": { "type": "string" },
        "refereeName": { "type": "string" },
        "rewardAmount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "completedAt": { "type": "string" }
      },
      "required": ["referrerId", "refereeId"]
    },
    "notifications": {
      "title": "notifications",
      "description": "User and platform notifications",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "message"]
    },
    "settings": {
      "title": "settings",
      "description": "Global application configuration",
      "type": "object",
      "properties": {
        "minWithdrawal": { "type": "number" },
        "referralBonus": { "type": "number" },
        "maintenanceMode": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/users" },
      "description": "User profile documents"
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/tasks" },
      "description": "Catalog of available daily tasks"
    },
    "/taskSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/taskSessions" },
      "description": "Pending and completed task session records"
    },
    "/taskCompletions/{completionId}": {
      "schema": { "$ref": "#/entities/taskCompletions" },
      "description": "User completed task logs"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/transactions" },
      "description": "User transaction history logs"
    },
    "/withdrawals/{withdrawalId}": {
      "schema": { "$ref": "#/entities/withdrawals" },
      "description": "User withdrawal requests"
    },
    "/referrals/{referralId}": {
      "schema": { "$ref": "#/entities/referrals" },
      "description": "Referral mappings and status"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/notifications" },
      "description": "Notification records"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/settings" },
      "description": "Platform settings"
    }
  }
}
